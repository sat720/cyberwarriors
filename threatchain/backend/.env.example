# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas > Connect > Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/threatchain?retryWrites=true&w=majority

# Server Port
PORT=5000

# CORS Origin (Frontend URL)
# For local development
CORS_ORIGIN=http://localhost:5173

# For production, change to your deployed frontend URL
# CORS_ORIGIN=https://your-frontend.vercel.app
